{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false,
    "target": "es2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": "./",
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "jsxFactory": "h",
    "types": ["vite/client", "vue"],
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.jsx", "src/**/*.json", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
